SUPABASE_URL=https://your-project.supabase.co
# Secret / service_role key (Supabase → Project Settings → API Keys). Server only, never put it in the browser.
SUPABASE_SERVICE_KEY=your-supabase-secret-key
# Publishable key (sb_publishable_...). Safe for the browser; used by the sign-in page.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
# Optional: Gemini model used for scoring
GEMINI_MODEL=gemini-3.8-flash
